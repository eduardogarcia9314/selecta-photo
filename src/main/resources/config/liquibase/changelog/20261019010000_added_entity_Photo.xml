<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20261019010000-1" author="selecta">

    <createTable tableName="photo">

      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="album_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="original_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>

      <column name="storage_key" type="VARCHAR(500)">
        <constraints nullable="false"/>
      </column>

      <column name="preview_key" type="VARCHAR(500)">
        <constraints nullable="false"/>
      </column>

      <column name="thumbnail_key" type="VARCHAR(500)">
        <constraints nullable="false"/>
      </column>

      <column name="content_type" type="VARCHAR(100)"/>

      <column name="file_size" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="uploaded_at" type="TIMESTAMP">
        <constraints nullable="false"/>
      </column>

    </createTable>

    <addForeignKeyConstraint
      baseTableName="photo"
      baseColumnNames="album_id"
      referencedTableName="album"
      referencedColumnNames="id"
      constraintName="fk_photo_album"/>

    <createIndex
      tableName="photo"
      indexName="idx_photo_album_id">

      <column name="album_id"/>

    </createIndex>

  </changeSet>

</databaseChangeLog>
